{
  "config_id": "m2-baseline-v1",
  "seed": 13,
  "normalization": {"unicode_form": "NFKC", "dehyphenate_linebreaks": true, "collapse_whitespace": true},
  "chunking": {
    "strategy": "heading_aware",
    "max_words": 300,
    "min_words": 40,
    "overlap_sentences": 1,
    "prepend_heading_path": true,
    "rationale": "bge-small-en-v1.5 truncates at 512 tokens; 300 words (~400 tokens) + heading prefix stays under the limit."
  },
  "bm25": {"k1": 1.5, "b": 0.75, "lowercase": true, "token_pattern": "[a-z0-9]+", "remove_stopwords": true, "stemming": false},
  "retrieval": {"top_k": 5},
  "planned": {
    "dense_model": "BAAI/bge-small-en-v1.5",
    "reranker": "BAAI/bge-reranker-base",
    "generator": "llama3.1:8b-instruct-q4_K_M (Ollama)",
    "generator_fallback": "llama3.2:3b-instruct-q4_K_M (Ollama)",
    "temperature": 0.0
  }
}
